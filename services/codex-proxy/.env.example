# Copy to .env and adjust. Every value has a default; nothing here is required.

# Where to listen. "127.0.0.1" keeps it on this Mac, "tailscale" binds to this
# machine's Tailscale IPv4 (100.x.y.z), "0.0.0.0" binds to every interface.
CODEX_PROXY_HOST=tailscale
CODEX_PROXY_PORT=8790

# Bearer token clients must send. Leave unset to have one generated and stored
# in the data directory on first start (it is printed at startup).
# CODEX_PROXY_TOKEN=

# Codex executable and models.
CODEX_PROXY_CODEX_BIN=codex
CODEX_PROXY_LIVE_MODEL=gpt-live-1-codex
CODEX_PROXY_DEFAULT_VOICE=cove
CODEX_PROXY_TEXT_MODEL=gpt-5.6-luna
CODEX_PROXY_TEXT_EFFORT=low

# How `session.thinking.append` is delivered to the live model:
#   buffer         (default) keep it and deliver it with the next instruction
#   flush-on-quiet also deliver it after CODEX_PROXY_QUIET_SECONDS of silence
#   immediate      deliver it at once (the model usually replies to it aloud)
CODEX_PROXY_THINKING=buffer
CODEX_PROXY_QUIET_SECONDS=8

# How the answer to a voice handoff (the live model asking Codex for help) comes back:
#   commentary  (default) Codex speaks the agent's answer through the live model
#   thinking    the answer becomes silent context; the model may or may not use it
CODEX_PROXY_HANDOFF=commentary

# Safety limits for voice sessions.
CODEX_PROXY_MAX_SESSION_MINUTES=60
CODEX_PROXY_CLIENT_GRACE_SECONDS=90

# Comma-separated list of allowed browser origins for CORS. "*" allows any
# origin; the bearer token still protects every endpoint.
CODEX_PROXY_CORS_ORIGINS=*

# Data directory for the generated token and the private Codex workspace.
# CODEX_PROXY_DATA_DIR=~/.config/codex-proxy

# debug | info | warn | error
CODEX_PROXY_LOG_LEVEL=info
