{
  "name": "codex-proxy",
  "version": "0.1.0",
  "description": "Local OpenAI-compatible proxy backed by the Codex CLI subscription: /v1/live/sessions and /v1/responses without an API key.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
